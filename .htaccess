<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

   RewriteEngine On

   # Keep the installation directory when normalizing application URLs.
   RewriteCond %{REQUEST_FILENAME} !-d
   RewriteCond %{REQUEST_URI} (.+)/$
   RewriteRule ^ %1 [L,R=301]

   # Resolve frontend assets before the Laravel front controller. These paths
   # are relative to this .htaccess, so no installation-specific RewriteBase
   # is needed. In particular, frontend vendor files live in public/vendor,
   # separately from the Composer dependencies in the root vendor directory.
   RewriteRule ^(dist|plugins|css|js|images|fonts|admin|webfonts|assets|vendor)/(.*)$ public/$1/$2 [L,NC]
   RewriteRule ^(favicon\.ico|logo\.png|robots\.txt)$ public/$1 [L,NC]

   RewriteCond %{REQUEST_FILENAME} !-d
   RewriteCond %{REQUEST_FILENAME} !-f
   RewriteRule ^ index.php [L]

</IfModule>
